# Güvenlik: Uploads dizininde PHP dosyalarının çalıştırılmasını engelle
# Bu, zararlı dosya yükleme saldırılarına karşı son savunma hattıdır

php_flag engine off

<FilesMatch "\.(?:php[0-9]?|phtml|pht|phps)$">
    Require all denied
</FilesMatch>

# Script çalıştırmayı engelle
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .pht
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .phps .pht
